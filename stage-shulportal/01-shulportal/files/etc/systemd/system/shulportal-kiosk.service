# ABOUTME: Full-screen Chromium on tty1 inside the cage Wayland compositor, as the kiosk user.
# ABOUTME: Restarted by shulportal-refresh when the TV should switch between /tv and a local page.
[Unit]
Description=ShulPortal kiosk
After=systemd-user-sessions.service seatd.service
Wants=seatd.service
Conflicts=getty@tty1.service
# Page switches and fast failures (seat or display not ready yet) must never park it.
StartLimitIntervalSec=0

[Service]
User=kiosk
TTYPath=/dev/tty1
RuntimeDirectory=kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/kiosk
ExecStart=/usr/bin/cage -s -- /usr/local/bin/shulportal-kiosk
StandardError=journal
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
