# ABOUTME: Full-screen Chromium on tty1 inside the cage Wayland compositor, as the kiosk user.
# ABOUTME: Restarted by shulportal-refresh when the TV should switch between /tv and a local page.
[Unit]
Description=ShulPortal kiosk
After=systemd-user-sessions.service seatd.service network-pre.target
Wants=seatd.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -- /usr/local/bin/shulportal-kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
