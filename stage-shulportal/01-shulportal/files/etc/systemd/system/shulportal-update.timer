# ABOUTME: Runs the remote-update check a minute after boot and every 5 minutes after that,
# ABOUTME: spread a little so a building's Pis don't all ask at once.
[Unit]
Description=ShulPortal remote update check, every 5 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
