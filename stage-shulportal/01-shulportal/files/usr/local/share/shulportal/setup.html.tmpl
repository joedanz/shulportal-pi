<!doctype html>
<!-- ABOUTME: The TV's offline setup page: join the setup hotspot from a phone, then pick Wi-Fi. -->
<!-- ABOUTME: shulportal-refresh fills in the hotspot name and an inline SVG Wi-Fi join code. -->
<html lang="en">
<head>
<meta charset="utf-8">
<title>ShulPortal setup</title>
<link rel="stylesheet" href="file:///usr/local/share/shulportal/tv.css">
<script src="file:///usr/local/share/shulportal/tv.js"></script>
</head>
<body>
<div class="screen">
  <div class="brand"><span class="brand-mark"></span><span class="brand-name">ShulPortal</span></div>
  <main class="body">
    <div class="setup">
      <div class="qr">{{QR}}</div>
      <div class="text">
        <p class="eyebrow">Set up this TV</p>
        <h1>Connect it to the shul's Wi-Fi</h1>
        <ol class="steps">
          <li>Scan the code with your phone's camera, or join this Wi-Fi:<br><span class="ssid">{{SSID}}</span></li>
          <li>On the page that opens, pick the shul's Wi-Fi and enter its password.</li>
          <li class="hint">This TV then shows a code to link it in ShulPortal.</li>
        </ol>
      </div>
    </div>
  </main>
  <div class="footer">shulportal.com</div>
</div>
</body>
</html>
