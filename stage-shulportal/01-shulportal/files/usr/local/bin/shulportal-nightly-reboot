#!/usr/bin/env bash
# ABOUTME: The nightly restart: waits (up to an hour) while the day's package upgrade is still running,
# ABOUTME: so a restart never lands mid-install. Skipped without internet, leaving the TV's screen alone.
set -euo pipefail

systemctl=${SHULPORTAL_SYSTEMCTL:-systemctl}
nmcli=${SHULPORTAL_NMCLI:-nmcli}
run=${SHULPORTAL_RUN:-/run/shulportal}

# shulportal-update restarts the Pi itself once an install is done.
if [ -e "$run/installing" ]; then
  echo "an update is installing: skipping tonight's restart"
  exit 0
fi

if [ "$("$nmcli" networking connectivity check 2>/dev/null || echo unknown)" != full ]; then
  echo "no internet: skipping tonight's restart"
  exit 0
fi
wait_secs=${SHULPORTAL_REBOOT_WAIT_SECS:-30}
max_waits=${SHULPORTAL_REBOOT_MAX_WAITS:-120}

waits=0
while [ "$waits" -lt "$max_waits" ] &&
  { "$systemctl" is-active --quiet apt-daily-upgrade.service || "$systemctl" is-active --quiet apt-daily.service; }; do
  waits=$((waits + 1))
  sleep "$wait_secs"
done
if [ "$waits" -gt 0 ]; then echo "waited for apt-daily-upgrade ($waits checks)"; fi

"$systemctl" reboot
