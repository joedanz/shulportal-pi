#!/usr/bin/env bash
# ABOUTME: Re-chooses what the TV shows from internet connectivity and the setup hotspot, renders
# ABOUTME: the setup page, and restarts the kiosk only when the page actually changes.
set -euo pipefail

# shellcheck source=/dev/null
source "${SHULPORTAL_LIB:-/usr/local/lib/shulportal/lib.sh}"
run=${SHULPORTAL_RUN:-/run/shulportal}
share=${SHULPORTAL_SHARE:-/usr/local/share/shulportal}
nmcli=${SHULPORTAL_NMCLI:-nmcli}
systemctl=${SHULPORTAL_SYSTEMCTL:-systemctl}
serial_file=${SHULPORTAL_SERIAL_FILE:-/proc/device-tree/serial-number}
comitup_json=${SHULPORTAL_COMITUP_JSON:-/var/lib/comitup/comitup.json}

mkdir -p "$run"
# Callers (comitup, NetworkManager, the watchdog) can fire together; take turns.
exec 9>"$run/refresh.lock"
if command -v flock >/dev/null; then flock 9; fi

# The name comitup really broadcasts comes from its id; before first boot writes it, use the serial.
hotspot_id() {
  local id
  id=$(sed -n 's/.*"id": *"\([^"]*\)".*/\1/p' "$comitup_json" 2>/dev/null || true)
  if [ -n "$id" ]; then echo "$id"; else ap_id_from_serial "$(tr -d '\0' < "$serial_file" 2>/dev/null || true)"; fi
}

connectivity=$("$nmcli" networking connectivity check 2>/dev/null || echo unknown)
if [ -n "$("$nmcli" -t -f NAME connection show --active 2>/dev/null | active_hotspot)" ]; then hotspot_up=yes; else hotspot_up=no; fi
current=$(cat "$run/page" 2>/dev/null || true)
since=$(cat "$run/offline-since" 2>/dev/null || true)
offline_secs=0
if [ -n "$since" ]; then offline_secs=$(( ${SHULPORTAL_NOW:-$(date +%s)} - since )); fi
page=$(choose_page "$connectivity" "$hotspot_up" "$current" "$offline_secs")

if [ "$page" = setup ]; then
  render_setup_page "$share/setup.html.tmpl" "$run/setup.html" "$(setup_ssid "$(hotspot_id)")"
fi
if [ "$page" != "$current" ]; then
  echo "$page" > "$run/page"
  "$systemctl" restart shulportal-kiosk
fi
