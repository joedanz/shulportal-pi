#!/usr/bin/env bash
# ABOUTME: Runs inside cage as the kiosk user: marks the last run clean, then execs Chromium
# ABOUTME: full screen on the page shulportal-refresh chose (ShulPortal /tv or a local page).
set -euo pipefail

# shellcheck source=/dev/null
source "${SHULPORTAL_LIB:-/usr/local/lib/shulportal/lib.sh}"
run=${SHULPORTAL_RUN:-/run/shulportal}
profile=${SHULPORTAL_PROFILE:-/var/lib/shulportal/chromium}
share=${SHULPORTAL_SHARE:-/usr/local/share/shulportal}

mark_clean_exit "$profile/Default/Preferences"

case "$(cat "$run/page" 2>/dev/null || true)" in
  online) url=https://shulportal.com/tv ;;
  setup) url="file://$run/setup.html" ;;
  *) url="file://$share/connecting.html" ;;
esac

exec "${SHULPORTAL_CHROMIUM:-chromium}" \
  --kiosk --noerrdialogs --disable-infobars --no-first-run \
  --hide-crash-restore-bubble --disable-session-crashed-bubble \
  --check-for-update-interval=31536000 --ozone-platform=wayland \
  --user-data-dir="$profile" "$url"
