#!/usr/bin/env bash
# ABOUTME: Runs inside cage as the kiosk user: marks the last run clean, then execs Chromium
# ABOUTME: full screen on the page shulportal-refresh (or shulportal-update) chose: ShulPortal /tv or a local page.
set -euo pipefail

# shellcheck source=/dev/null
source "${SHULPORTAL_LIB:-/usr/local/lib/shulportal/lib.sh}"
run=${SHULPORTAL_RUN:-/run/shulportal}
profile=${SHULPORTAL_PROFILE:-/var/lib/shulportal/chromium}
share=${SHULPORTAL_SHARE:-/usr/local/share/shulportal}
state=${SHULPORTAL_STATE:-/var/lib/shulportal}

mark_clean_exit "$profile/Default/Preferences"
# A power cut leaves Chromium's single-instance locks behind; they'd point at a dead process.
rm -f "$profile/SingletonLock" "$profile/SingletonSocket" "$profile/SingletonCookie"

# How the TV hangs, from its sign (shulportal-update saves it): the pages below turn to match.
turn=$(saved_turn "$state/turn")

case "$(cat "$run/page" 2>/dev/null || true)" in
  online | cached)
    # The device id lets the admin page offer this Pi updates; without one the sign still shows.
    if id=$(ensure_device_id "$state/device-id" 2>/dev/null); then
      url="https://shulportal.com/tv?device=$id${turn:+&turn=$turn}"
    else
      url="https://shulportal.com/tv${turn:+?turn=$turn}"
    fi
    ;;
  setup) url="file://$run/setup.html${turn:+?turn=$turn}" ;;
  updating) url="file://$share/updating.html${turn:+?turn=$turn}" ;;
  *) url="file://$share/connecting.html${turn:+?turn=$turn}" ;;
esac

exec "${SHULPORTAL_CHROMIUM:-chromium}" \
  --kiosk --noerrdialogs --disable-infobars --no-first-run \
  --hide-crash-restore-bubble --disable-session-crashed-bubble \
  --check-for-update-interval=31536000 --ozone-platform=wayland \
  --user-data-dir="$profile" "$url"
