#!/usr/bin/env bash
# ABOUTME: Remote updates (root, every 5 minutes from shulportal-update.timer): asks ShulPortal whether to install
# ABOUTME: a newer release, then downloads it, checks its signature, installs it and restarts; on failure, puts it back.
set -euo pipefail

# shellcheck source=/dev/null
source "${SHULPORTAL_LIB:-/usr/local/lib/shulportal/lib.sh}"
run=${SHULPORTAL_RUN:-/run/shulportal}
state=${SHULPORTAL_STATE:-/var/lib/shulportal}
update_dir=${SHULPORTAL_UPDATE_DIR:-/var/lib/shulportal-update}
api=${SHULPORTAL_API:-https://shulportal.com}
key=${SHULPORTAL_RELEASE_KEY:-/usr/local/share/shulportal/release-key.pem}
curl=${SHULPORTAL_CURL:-curl}
apt_get=${SHULPORTAL_APT_GET:-apt-get}
dpkg=${SHULPORTAL_DPKG:-dpkg}
dpkg_query=${SHULPORTAL_DPKG_QUERY:-dpkg-query}
dpkg_deb=${SHULPORTAL_DPKG_DEB:-dpkg-deb}
openssl=${SHULPORTAL_OPENSSL:-openssl}
systemctl=${SHULPORTAL_SYSTEMCTL:-systemctl}
refresh=${SHULPORTAL_REFRESH:-/usr/local/bin/shulportal-refresh}
chromium_check=${SHULPORTAL_CHROMIUM_CHECK:-/usr/local/bin/shulportal-chromium-check}
# Unattended: wait for apt's lock, and keep any changed config file rather than stop to ask.
apt_opts=(-o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
export DEBIAN_FRONTEND=noninteractive

mkdir -p "$update_dir" "$run"
# In /run (memory), so a check every 5 minutes never writes to the SD card.
exec 9>"$run/update.lock"
# Only one at a time: an install can outlast the timer's 5 minutes.
if command -v flock >/dev/null; then flock -n 9 || exit 0; fi

# The kiosk writes the id at its first start; until then there's nothing to ask about.
device=$(cat "$state/device-id" 2>/dev/null || true)
[[ $device =~ ^[0-9a-f]{32}$ ]] || exit 0
# put_back: the package from before, after a failed or interrupted install (dpkg may have been left mid-way).
# Fails when even the old package wouldn't go back on.
put_back() {
  "$dpkg" --configure -a || true
  "$apt_get" "${apt_opts[@]}" install -y --reinstall --allow-downgrades "$update_dir/current.deb"
}

# An install that was cut off (power, a kill) leaves the package half-installed: put the old one back first.
# shellcheck disable=SC2016 # ${Status} and ${Version} are dpkg-query's formats, not the shell's.
if [ "$("$dpkg_query" -W -f='${Status}' shulportal-pi 2>/dev/null || true)" != "install ok installed" ]; then put_back || true; fi
# shellcheck disable=SC2016
version=$("$dpkg_query" -W -f='${Version}' shulportal-pi 2>/dev/null || true)
# A dev build reports 0.0.0 so its card shows something, but never installs a release (install_target refuses it).
reported=$version
is_version "$reported" || reported=0.0.0

# check BODY: posts a check and prints the reply; fails when ShulPortal can't be reached.
check() {
  "$curl" -fsS --max-time 20 -H 'Content-Type: application/json' -d "$1" "$api/api/pi/check"
}

# A failure the last run couldn't report goes with this check, once.
body=$(check_body "$device" "$reported")
if [ -s "$update_dir/failed" ]; then
  { read -r failed_version; read -r failed_reason; } < "$update_dir/failed" || true
  body=$(check_body "$device" "$reported" "${failed_version:-}" "${failed_reason:-}")
fi
reply=$(check "$body") || exit 0
rm -f "$update_dir/failed"

target=$(install_target "$reply" "$version")
[ -n "$target" ] || exit 0

incoming="$update_dir/incoming"
deb="$incoming/shulportal-pi_${target}_all.deb"

screen=no
installing=no
finished=no
# fail REASON: gives the screen back if the install had it, then reports the failure (or leaves it for the next check).
fail() {
  finished=yes
  printf '%s\n%s\n' "$target" "$1" > "$update_dir/failed"
  rm -rf "$incoming"
  if [ "$screen" = yes ]; then
    rm -f "$run/installing" "$run/page"
    "$refresh" || true
  fi
  if check "$(check_body "$device" "$reported" "$target" "$1")" >/dev/null; then rm -f "$update_dir/failed"; fi
  exit 0
}

# Cut off mid-install (systemd's timeout, a failing mv or reboot): never leave the TV on the updating page.
interrupted() {
  [ "$finished" = no ] && [ "$screen" = yes ] || return 0
  if [ "$installing" = yes ]; then put_back || true; fi
  fail "The update was interrupted."
}
trap interrupted EXIT
trap 'exit 143' TERM INT

# Downloaded and checked while the sign keeps showing: a bad download never blanks the TV.
rm -rf "$incoming"
mkdir -p "$incoming"
url="$api/api/pi/release/$target/shulportal-pi_${target}_all.deb"
if ! { "$curl" -fsS --max-time 300 -o "$deb" "$url" && "$curl" -fsS --max-time 300 -o "$deb.sig" "$url.sig"; }; then
  fail "The download didn't finish."
fi
"$openssl" pkeyutl -verify -pubin -inkey "$key" -rawin -in "$deb" -sigfile "$deb.sig" >/dev/null 2>&1 ||
  fail "The download's signature didn't check out."
if [ "$("$dpkg_deb" -f "$deb" Package 2>/dev/null)" != shulportal-pi ] ||
  [ "$("$dpkg_deb" -f "$deb" Version 2>/dev/null)" != "$target" ]; then
  fail "The download wasn't the version asked for."
fi

# The screen says what's happening, and nothing switches it back mid-install. Taken between refreshes (their
# lock), so one already running can't write its page over this one; later ones see the flag and leave it be.
exec 8>"$run/refresh.lock"
if command -v flock >/dev/null; then flock 8; fi
screen=yes
touch "$run/installing"
echo updating > "$run/page"
exec 8>&-
"$systemctl" restart shulportal-kiosk || true

installing=yes
# roll_back REASON: puts the old package back, then fails with REASON (or says the put-back failed too).
roll_back() {
  if put_back; then fail "$1"; fi
  fail "Installing failed, and the old version couldn't be put back."
}

if ! "$apt_get" "${apt_opts[@]}" install -y "$deb"; then
  roll_back "Installing the new version failed."
fi
# The new package's Chromium list may block the installed build and name one to put back.
if ! chromium_out=$("$chromium_check" 2>&1); then
  roll_back "$(printf '%s\n' "$chromium_out" | tail -n1)"
fi

mv "$deb" "$update_dir/current.deb"
rm -rf "$incoming"
"$systemctl" reboot
finished=yes
