#!/usr/bin/env python3
# ABOUTME: Keeps how a TV hangs as picked on the phone during Wi-Fi setup, for a Pi no sign has linked yet.
# ABOUTME: The setup page posts the pick over the hotspot; the TV's setup page reads it back on loopback (tv.js).
"""Small HTTP service on port 8411, as the kiosk user, while the setup page is up (shulportal-refresh).

GET  /turn            right, left or none; from the hotspot (the phone page) or loopback (the TV's setup page).
POST /turn turn=...   right, left or none; from the hotspot only, so nobody on the shul's network can turn a TV.

The turn file is lib.sh's: it writes through set_turn, as shulportal-update does with the sign's turn, so once a
sign links the Pi, the sign's turn replaces the phone's.
"""
import os
import subprocess
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs

LIB = os.environ.get("SHULPORTAL_LIB", "/usr/local/lib/shulportal/lib.sh")
TURN_FILE = os.path.join(os.environ.get("SHULPORTAL_STATE", "/var/lib/shulportal"), "turn")
PORT = int(os.environ.get("SHULPORTAL_TURN_PORT", "8411"))
# comitup's hotspot address (its web page lives at http://10.41.0.1/).
HOTSPOT = os.environ.get("SHULPORTAL_HOTSPOT_ADDR", "10.41.0.1")
LOOPBACK = {"127.0.0.1", "::1"}


def read_turn():
    """lib.sh saved_turn, or none."""
    try:
        with open(TURN_FILE) as f:
            turn = f.read().strip()
    except OSError:
        return "none"
    return turn if turn in ("right", "left") else "none"


def set_turn(turn):
    """lib.sh set_turn: False for anything but right, left or none."""
    script = 'source "$0" && set_turn "$1" "$2"'
    return subprocess.run(["bash", "-c", script, LIB, TURN_FILE, turn]).returncode == 0


def may(method, local_addr):
    """Who may do what, by the address the request reached: the hotspot's, or loopback for reading."""
    return local_addr == HOTSPOT or (method == "GET" and local_addr in LOOPBACK)


class Handler(BaseHTTPRequestHandler):
    timeout = 5  # a phone that drops mid-request can't hold the one thread

    def reply(self, code, body=b""):
        self.send_response(code)
        # The phone page is another origin (port 80), and the TV's pages are file://.
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def allowed(self):
        if self.path.split("?")[0] != "/turn":
            self.reply(404)
        elif not may(self.command, self.connection.getsockname()[0]):
            self.reply(403)
        else:
            return True
        return False

    def do_GET(self):
        if self.allowed():
            self.reply(200, read_turn().encode())

    def do_POST(self):
        if not self.allowed():
            return
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length).decode("ascii", "replace") if 0 < length <= 64 else ""
        turn = parse_qs(body).get("turn", [""])[0]
        if not set_turn(turn):
            self.reply(400)
            return
        print(f"turn {turn}, picked on the phone", flush=True)
        self.reply(204)

    def log_message(self, *args):
        pass  # the TV's setup page asks every few seconds; only a pick is worth a journal line


if __name__ == "__main__":
    HTTPServer(("", PORT), Handler).serve_forever()
