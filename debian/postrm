#!/bin/sh
# ABOUTME: After shulportal-pi is removed: gives comitup its own /etc/comitup.conf and Wi-Fi pages back.
# ABOUTME: An upgrade keeps the diverts, since the new version ships the same files.
set -e
pages=/usr/share/comitup/web/templates
case "$1" in
  remove | purge | abort-install)
    dpkg-divert --package shulportal-pi --remove --rename --divert /etc/comitup.conf.comitup /etc/comitup.conf
    dpkg-divert --package shulportal-pi --remove --rename --divert $pages/index.html.comitup $pages/index.html
    dpkg-divert --package shulportal-pi --remove --rename --divert $pages/confirm.html.comitup $pages/confirm.html
    dpkg-divert --package shulportal-pi --remove --rename --divert $pages/connect.html.comitup $pages/connect.html
    ;;
esac
