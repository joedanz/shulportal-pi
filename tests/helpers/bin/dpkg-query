#!/usr/bin/env bash
# ABOUTME: Test stand-in for dpkg-query -W -f='${Version}' PKG: prints $STUB_PI_VERSION for shulportal-pi
# ABOUTME: and $STUB_CHROMIUM_VERSION for chromium, with no newline as dpkg-query does; ${Status} is $STUB_PI_STATUS.
if [[ $* == *'${Status}'* ]]; then
  [ "${*: -1}" = shulportal-pi ] && printf '%s' "${STUB_PI_STATUS:-install ok installed}"
  exit 0
fi
case ${*: -1} in
  shulportal-pi) printf '%s' "${STUB_PI_VERSION:-1.1.0}" ;;
  chromium) printf '%s' "${STUB_CHROMIUM_VERSION:-1:156.0.8078.79-1~deb13u1+rpt1}" ;;
  *) exit 1 ;;
esac
