#!/usr/bin/env bash
# ABOUTME: Test stand-in for shulportal-refresh: logs that it ran, after $STUB_REFRESH_SLEEP seconds,
# ABOUTME: and what $SHULPORTAL_RUN held then. Lets tests prove callers return without waiting for a refresh.
sleep "${STUB_REFRESH_SLEEP:-0}"
echo ran >> "$STUB_LOG/refresh.log"
echo "page=$(cat "${SHULPORTAL_RUN:-/nonexistent}/page" 2>/dev/null) installing=$([ -e "${SHULPORTAL_RUN:-/nonexistent}/installing" ] && echo yes || echo no)" >> "$STUB_LOG/refresh-state.log"
